# Copy this file to .env in the project root. Docker Compose reads this file.

BACKEND_PORT=4000
FRONTEND_PORT=5173
CORS_ORIGIN=http://localhost:5173

# Seed a few demo clinicians/patients/visits on first boot.
SEED_DB=true

# Required. Neon pooled connection string from https://console.neon.tech
# (Connect → enable Connection pooling). No local Postgres fallback.
# connect_timeout=15 covers Neon compute wake-from-idle.
# The app connects over WebSockets (443) via @neondatabase/serverless —
# see README "Why WebSockets".
DATABASE_URL=postgres://user:password@ep-example-pooler.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=15
