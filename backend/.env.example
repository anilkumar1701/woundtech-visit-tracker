# Used only when you run the API on the host (`npm run dev`).
# Docker Compose ignores this file and reads the project-root .env instead.

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Required. Same Neon pooled connection string as the root .env.
# No local-database fallback. See the README's Neon / WebSocket section.
DATABASE_URL=postgres://user:password@ep-example-pooler.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=15
